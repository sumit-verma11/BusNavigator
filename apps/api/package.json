{
  "name": "@busnav/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.js\"",
    "migrate": "node --env-file-if-exists=../../.env ../../node_modules/.bin/node-pg-migrate -m migrations -j sql",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:create": "npm run migrate -- create",
    "ingest:static": "node src/bin/ingest-static.js",
    "poll:realtime": "node src/bin/poll-realtime.js",
    "seed:sample": "node src/bin/seed-sample.js",
    "dev:refresh": "node src/bin/dev-refresh.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "gtfs-realtime-bindings": "^2.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0"
  }
}
