{
  "name": "busnavigator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@busnav/api",
    "test": "npm run test --workspace=@busnav/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate:up --workspace=@busnav/api",
    "db:reset": "docker compose down -v && npm run db:up && sleep 5 && npm run db:migrate",
    "prepare": "husky",
    "dev:api": "npm run dev --workspace=@busnav/api",
    "dev:web": "npm run dev --workspace=@busnav/web",
    "build:web": "npm run build --workspace=@busnav/web",
    "verify": "npm run lint && npm run format:check && npm test && npm run build:web",
    "e2e": "npm run e2e --workspace=@busnav/web"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2"
  }
}
