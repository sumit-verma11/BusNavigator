# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Postgres (docker-compose defaults; override in staging/prod with managed URL)
POSTGRES_USER=busnav
POSTGRES_PASSWORD=busnav
POSTGRES_DB=busnav
POSTGRES_PORT=5432
DATABASE_URL=postgres://busnav:busnav@localhost:5432/busnav

# Redis (live vehicle state + response cache)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# GTFS feeds. Static = zip URL, RT = protobuf endpoint.
# Delhi (DTC/DIMTS) OTD feeds require a free API key from https://otd.delhi.gov.in
GTFS_STATIC_URL=
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_API_KEY=

# Ingestion tuning
GTFS_RT_POLL_INTERVAL_MS=10000
GTFS_RT_FAILURE_THRESHOLD=5

# Route search: when no bus runs from the exact picked stop, widen to stops within
# this many metres and name the one the bus actually leaves from (GTFS splits one
# place into many stop ids; newcomers pick by name). 800m = classic transit walkshed.
ROUTE_FALLBACK_RADIUS_M=800

# API surface. Comma-separated. Next falls back to 3001+ when 3000 is taken
# (Docker Desktop grabs 3000 on some machines), so allow both in local dev.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Frontend -> API. Read by the browser, so it must be NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:4000
